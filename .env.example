# Copy to .env.local and fill in once you have real values. All optional —
# the site works without them, these just enable extra SEO/analytics wiring.

# Google Search Console: Settings > Ownership verification > HTML tag,
# copy just the "content" value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=6JQ3E9oH9VXQksOAhpdfHKzYfdyMG27Vt8nkg5Tn-Tw

# Bing Webmaster Tools: Settings > Ownership verification > HTML Meta Tag,
# copy just the "content" value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=4F2510BF6B2669AE60A73BF97DC11B5D

# Google Analytics 4 measurement ID (starts with "G-"). Leave empty to
# skip loading GA entirely — no script is injected unless this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YPPMMBWQ72

# Contact form SMTP relay
# Obtain these values from your email provider's mail-client setup page.
# Port 465 uses implicit TLS; port 587 usually uses STARTTLS.

SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=your_smtp_password_here

# Address that receives contact-form and review-moderation emails.
# Defaults to SMTP_USER when omitted.
CONTACT_TO_EMAIL=hello@example.com

# Neon PostgreSQL connection string (used for storing project inquiries and moderated reviews)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional webhooks for inquiry and review-moderation persistence on serverless hosts
# CONTACT_WEBHOOK_URL=
# REVIEWS_WEBHOOK_URL=
# Optional persistent directory path for private submission JSON files on self-hosted servers
# SUBMISSIONS_STORAGE_DIR=