# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_32_byte_random_secret
# Set to https://www.janidudev.com in Production; leave unset on Vercel Preview deployments
BETTER_AUTH_URL=http://localhost:3000

# --- Neon Object Storage (S3-Compatible Media Library) ---
AWS_ENDPOINT_URL_S3=https://your-neon-s3-endpoint.example.com
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
STORAGE_BUCKET_NAME=your-bucket-name
# Optional public CDN/bucket base URL (if omitted, objects are served via presigned/proxy URLs)
# STORAGE_PUBLIC_BASE_URL=

# --- Transactional Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
# Verified sending address (e.g. JaniduDev <notifications@mail.janidudev.com>)
RESEND_FROM_EMAIL=JaniduDev <onboarding@resend.dev>
# Business inbox that receives new customer enquiry alerts
CONTACT_TO_EMAIL=hello@janidudev.com

# --- Optional Legacy SMTP Fallback ---
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_USER=hello@example.com
# SMTP_PASS=your_smtp_password_here

# --- Optional SEO & Analytics ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
